# --- Core dashboard ---
# PORT — bind the dashboard HTTP server on this port. Free hosts (Railway,
# Render, Fly, etc.) inject PORT automatically; leave unset there.
PORT=5000
# HOST — interface to bind. Use 0.0.0.0 inside containers so the platform
# can route traffic to the process. Defaults to 0.0.0.0.
HOST=0.0.0.0

# --- Persistence ---
# DATA_DIR — single root for all stateful files (db.json, WhatsApp sessions,
# downloads, generated JWT secret). Set this to a mounted persistent volume
# on Railway / Render / Fly / Heroku-style hosts so state survives deploys.
# Example: DATA_DIR=/data
# When unset the app writes inside the repo directory (fine for local dev).
DATA_DIR=

# --- Bot identity ---
BOT_NAME=Chathu MD
OWNER_NUMBER=94742514900
PREFIX=.

# --- Menu interactive card (optional) ---
# When set, the main `.menu` (button mode on) sends a wabase-button-style
# interactive card with banner image + Visit Us / Call us CTA pills on top.
# Leave unset to keep the existing plain-text + Open Menu layout.
#
# MENU_BANNER_URL  — banner image shown above the menu body
# MENU_WEBSITE_URL — "🔗 Visit Us"  CTA button (opens link in browser)
# OWNER_NUMBER     — "📞 Call us"   CTA button (uses the number above)
MENU_BANNER_URL=
MENU_WEBSITE_URL=

# --- Admin auth ---
# If ADMIN_PASS is left blank we fall back to the default "chathura123" — set
# this to something unique on production. JWT_SECRET is auto-generated and
# persisted under DATA_DIR/.jwt_secret on first boot if not provided here.
ADMIN_USER=admin
ADMIN_PASS=chathura123
JWT_SECRET=
PREMIUM_CODE=CHATHU2026

# --- Runtime defaults ---
WORK_MODE=public
AUTO_READ=true
AUTO_TYPING=true
NSFW_ENABLED=true

# --- AI providers (optional, all unset = AI disabled) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
